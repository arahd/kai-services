    "@angular/platform-browser": "^20.3.9",
    "@angular/platform-browser-dynamic": "^20.3.9",
    "@angular/router": "^20.3.9",
    "@azure/msal-angular": "^4.0.20",
    "@azure/msal-browser": "^4.25.0",
    "@microsoft/applicationinsights-angularplugin-js": "^15.4.1",
    "@microsoft/applicationinsights-web": "^3.4.3",
    "apexcharts": "^5.3.6",
    "docx-preview": "^0.4.0",
    "highlight.js": "^11.11.1",
    "marked": "^16.4.0",
    "mermaid": "^12.0.0",
    "micromark": "^4.0.2",
    "ng-apexcharts": "^2.0.3",
