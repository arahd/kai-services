{
  "name": "kai",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:chatbot-sidenav": "ng test --include=src/app/features/chatbot/**/*.spec.ts --include=src/app/features/sidenav/**/*.spec.ts",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:coverage": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.9",
